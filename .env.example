# ──────────────────────────────────────────────────────────────
# Transport DSS · 環境變數範本
# ──────────────────────────────────────────────────────────────
# 使用方式：
#   cp .env.example .env
#   填入下列金鑰後即可啟用即時 API 模式。
#   若任一金鑰留空，對應的 client 會降級為「靜態 CSV fallback」並在 UI 提示。
# ──────────────────────────────────────────────────────────────

# Google Maps Platform（Directions / Distance Matrix / Geocoding）
# 申請：https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=

# TDX 運輸資料流通服務（高鐵/台鐵/捷運/公車）
# 申請：https://tdx.transportdata.tw/  →  會員中心 → 我的金鑰
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# ── 進階設定（可不動，使用預設值） ───────────────────────────
# 是否啟用即時 API（false = 全部走靜態 CSV）
ENABLE_REALTIME=true

# 本地快取目錄（預設 data/cache）
CACHE_DIR=data/cache

# 各類資料 TTL（秒），覆寫 config/settings.py 中的預設
# TTL_STATIC_METADATA=86400
# TTL_TIMETABLE=21600
# TTL_DIRECTIONS=300
# TTL_BUS_ETA=30
# TTL_YOUBIKE=60
